# =========================================================================
# PRODUCTION environment template.
#
# Copy to .env.production, replace every __REPLACE__ marker, then verify:
#
#     python scripts/check_production_env.py .env.production
#
# It exits non-zero until the file is actually safe, and is meant to run in
# the deploy pipeline. This template FAILS that check as shipped, on purpose:
# a template that passes untouched is a template someone will deploy untouched.
# =========================================================================

APP_NAME=HelpDoctor
ENV=production
DEBUG=false

# --- Database ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=helpdoctor_db
POSTGRES_USER=helpdoctor_user
POSTGRES_PASSWORD=__REPLACE_WITH_GENERATED_PASSWORD__

# --- Redis ---------------------------------------------------------------
# Redis starts with --requirepass ${REDIS_PASSWORD}, so BOTH urls below must
# carry the same credential. Miss one and that half fails with NOAUTH while the
# other works: an unauthenticated REDIS_URL breaks the Celery broker, cache and
# websocket pub/sub, and an unauthenticated RATE_LIMIT_STORAGE_URI removes rate
# limiting from /auth/login without any error the application reports.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=__REPLACE_WITH_GENERATED_REDIS_PASSWORD__
REDIS_URL=redis://:__REPLACE_WITH_GENERATED_REDIS_PASSWORD__@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
# Shared backend, NOT in-memory: per-process limits mean N replicas allow N
# times the configured rate, so /auth/login's 5/minute becomes 5N.
RATE_LIMIT_STORAGE_URI=redis://:__REPLACE_WITH_GENERATED_REDIS_PASSWORD__@redis:6379/1

# --- JWT -----------------------------------------------------------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=__REPLACE_WITH_48_BYTE_URLSAFE_TOKEN__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MFA -----------------------------------------------------------------
MFA_REQUIRED_ROLES=super_admin,admin
# Dedicated key. Left blank it is derived from JWT_SECRET_KEY, and rotating
# that would make every stored MFA secret undecryptable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_SECRET_ENCRYPTION_KEYS=__REPLACE_WITH_FERNET_KEY__

# --- Public URLs ---------------------------------------------------------
# https, and your real domain. http here means patient data in cleartext, and
# a localhost value means CORS rejects every browser request while curl works.
BASE_URL=https://__REPLACE_WITH_YOUR_DOMAIN__
FRONTEND_URL=https://__REPLACE_WITH_YOUR_DOMAIN__
ALLOWED_ORIGINS=https://__REPLACE_WITH_YOUR_DOMAIN__

# Host header allowlist (hostnames only, no scheme, no port).
# nginx accepts any Host and forwards it verbatim, so this is what stops a
# forged one. The app refuses to start in production while this still
# carries the development default.
ALLOWED_HOSTS=__REPLACE_WITH_YOUR_DOMAIN__

# --- Metrics -------------------------------------------------------------
# Unset, /metrics returns 404 under ENV=production and Prometheus goes blind.
# Prometheus must send it via bearer_token_file — see prometheus.yml.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=__REPLACE_WITH_GENERATED_TOKEN__

# --- File storage --------------------------------------------------------
# s3 is required before running more than one api replica.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=__REPLACE_OR_LEAVE_BLANK_FOR_AWS__
S3_BUCKET=__REPLACE_WITH_BUCKET__
S3_ACCESS_KEY=__REPLACE__
S3_SECRET_KEY=__REPLACE__
S3_REGION=us-east-1

# --- Offsite backups -----------------------------------------------------
# A DIFFERENT failure domain — another provider, or other hardware in another
# region. Same-host storage is a copy, not a backup.
# Write-only credentials where the provider supports it.
OFFSITE_ENDPOINT_URL=__REPLACE__
OFFSITE_ACCESS_KEY=__REPLACE__
OFFSITE_SECRET_KEY=__REPLACE__
OFFSITE_BUCKET=__REPLACE_WITH_OFFSITE_BUCKET__
OFFSITE_PREFIX=helpdoctor

# --- Email ---------------------------------------------------------------
MAIL_HOST=__REPLACE__
MAIL_PORT=587
MAIL_USERNAME=__REPLACE__
MAIL_PASSWORD=__REPLACE__
MAIL_FROM=noreply@__REPLACE_WITH_YOUR_DOMAIN__
MAIL_USE_TLS=true

# --- Google OAuth --------------------------------------------------------
GOOGLE_CLIENT_ID=__REPLACE__
GOOGLE_CLIENT_SECRET=__REPLACE__

# --- Web push ------------------------------------------------------------
VAPID_PUBLIC_KEY=__REPLACE__
VAPID_PRIVATE_KEY=__REPLACE__
VAPID_EMAIL=mailto:__REPLACE__

# --- Payments ------------------------------------------------------------
PAYMENT_GATEWAY=bkash
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=__REPLACE__
BKASH_APP_SECRET=__REPLACE__
BKASH_USERNAME=__REPLACE__
BKASH_PASSWORD=__REPLACE__
BKASH_CALLBACK_URL=https://__REPLACE_WITH_YOUR_DOMAIN__/api/payments/bkash/callback
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_CALLBACK_URL=https://__REPLACE_WITH_YOUR_DOMAIN__/api/payments/webhook/nagad
ROCKET_BASE_URL=https://api.rocket.com
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
ROCKET_CALLBACK_URL=https://__REPLACE_WITH_YOUR_DOMAIN__/api/payments/webhook/rocket

# --- WhatsApp (required at startup even when unused) ---------------------
WHATSAPP_ACCESS_TOKEN=__REPLACE__
WHATSAPP_PHONE_NUMBER_ID=__REPLACE__

# --- Observability -------------------------------------------------------
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- AI (off unless you have a key) --------------------------------------
ENABLE_MEDICINE_AI=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Elasticsearch -------------------------------------------------------
ELASTIC_HOST=

# --- Retention / pools ---------------------------------------------------
PHI_ACCESS_LOG_RETENTION_DAYS=2190
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
CELERY_WORKER_CONCURRENCY=4
TEST_POSTGRES_DB=helpdoctor_user_test
