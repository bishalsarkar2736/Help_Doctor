# =========================
# Application
# =========================
APP_NAME=HelpDoctor
ENV=development
DEBUG=true

# Hostnames this deployment answers on, comma separated.
#
# The Host header is supplied by the client and nginx forwards it verbatim, so
# anything trusting it -- absolute URLs in password-reset mail, cache keys,
# tenant resolution -- inherits that. This is the allowlist that stops a forged
# one at the door.
#
# The value below is for LOCAL WORK ONLY. Production must name its own
# hostnames, and Settings REFUSES TO START when ENV=production and this is
# still the development default, empty, loopback-only, or a wildcard. That is
# deliberate: the failure arrives at startup with a message, rather than as
# every request returning 400 once traffic reaches the containers.
#
#   ALLOWED_HOSTS=app.your-domain.example,www.app.your-domain.example
#
# Entries are literal hostnames. There is no pattern matching -- the Host header
# is compared by equality -- so "*" and "*.your-domain.example" match nothing
# and reject everything. Ports are ignored, so name the host only.
#
# localhost and 127.0.0.1 are always accepted and need not be listed: the
# container healthcheck calls http://localhost:8000/health/live even in
# production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# =========================
# PostgreSQL
# =========================
# Running the stack with docker compose? Use 5433 — that is the postgres
# service published to the host (5433->5432) — so host-run tooling (alembic,
# scripts) targets the same database as the containers. Pointing this at a
# separately installed postgres on 5432 gives you two copies of the database
# drifting to different migration revisions.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=helpdoctor
POSTGRES_USER=helpdoctor_user
POSTGRES_PASSWORD=strongpassword

# The test suite derives its connection from the POSTGRES_* values above and
# only swaps the database name, so there is no second credential to manage.
# It refuses to run if this resolves to POSTGRES_DB — reset_database() drops
# the schema, and pointing that at live data would destroy patient records.
TEST_POSTGRES_DB=helpdoctor_user_test

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# =========================
# Elasticsearch
# =========================
ELASTIC_HOST=http://localhost:9200

# =========================
# JWT
# =========================
JWT_SECRET_KEY=replace_with_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =========================
# Email
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# =========================
# QR Verification
# =========================
BASE_URL=http://localhost:8000

# =========================
# CORS
# =========================
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# =========================
# Metrics
# =========================
# Required in production - Prometheus scrape config must send
# "Authorization: Bearer <token>". Leave blank in dev.
METRICS_TOKEN=

# OpenTelemetry OTLP/HTTP traces collector endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Sentry error monitoring. Leave blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Rate-limit storage. Blank = in-memory (per-process). For multiple instances
# use a shared backend, e.g. async+redis://localhost:6379
RATE_LIMIT_STORAGE_URI=

# =========================
# VAPID
# =========================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# =========================
# AI
# =========================
ENABLE_MEDICINE_AI=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# =========================
# Offsite backups
# =========================
# db_backup and files_backup write to a volume on THIS machine. That is a copy,
# not a backup: if the host dies the database and every backup of it die
# together, and ransomware encrypts both in one pass.
#
# Point these at a DIFFERENT FAILURE DOMAIN — another provider, or at minimum
# other hardware in another region. A bucket on the same box satisfies the
# script and none of the purpose. Then start it:
#
#   docker compose --profile offsite up -d offsite_backup
#
# Use WRITE-ONLY credentials where the provider allows (s3:PutObject without
# s3:DeleteObject): a host that can delete its own offsite backups has not
# moved the failure domain very far.
OFFSITE_ENDPOINT_URL=
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=
OFFSITE_BUCKET=
OFFSITE_PREFIX=helpdoctor

# =========================
# MFA secret encryption
# =========================
# Encrypts users.mfa_secret at rest. Comma-separated urlsafe-base64 Fernet
# keys: the FIRST encrypts, ALL are tried when decrypting, which is what makes
# rotation possible (prepend new key -> re-save values -> drop old key).
#
# Leave empty and a key is derived from JWT_SECRET_KEY instead. That works out
# of the box but couples them: rotating JWT_SECRET_KEY then makes every stored
# MFA secret undecryptable and locks those users out of their second factor.
# Set a dedicated key before you ever rotate the JWT secret.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_SECRET_ENCRYPTION_KEYS=

# =========================
# WhatsApp (Meta Cloud API)
# =========================
# Required at startup even when WhatsApp notifications are unused — Settings
# declares them without defaults, so the application will not boot if they are
# missing. Placeholders are fine until you actually enable WhatsApp.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=123456789

# =========================
# Payments
# =========================
# Active payment gateway: "bkash" (live) or "fake" (dev/test simulate flow).
# "fake" is rejected when ENV=production.
PAYMENT_GATEWAY=bkash

# =========================
# bKash
# =========================
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:8000/api/payments/bkash/callback
# =========================
# Nagad
# =========================
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_CALLBACK_URL=http://localhost:8000/api/payments/webhook/nagad
# =========================
# Rocket
# =========================
ROCKET_BASE_URL=https://api.rocket.com
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
ROCKET_CALLBACK_URL=http://localhost:8000/api/payments/webhook/rocket
# DB connection pool, per process. Ceiling across all processes must stay
# below the server's max_connections (see app/config.py for the budget).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Celery prefork children. Multiplies the DB connection ceiling above.
CELERY_WORKER_CONCURRENCY=4

# =========================
# File storage
# =========================
# "local" = uploads/ and media/ directories (single API replica only).
# "s3"    = S3-compatible object storage; REQUIRED before running more than
#           one api replica, or uploads land on one replica and 404 on another.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=helpdoctor
S3_ACCESS_KEY=helpdoctor
S3_SECRET_KEY=change_me_in_production
S3_REGION=us-east-1
